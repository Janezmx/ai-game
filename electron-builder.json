{
  "appId": "com.aigame.boundary",
  "productName": "清醒边界",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/**/*",
    "frontend/dist/**/*",
    "backend/.env.local",
    "package.json"
  ],
  "npmRebuild": false,
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "language": "2052"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "electron/icon.png"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "electron/icon.png"
  }
}
